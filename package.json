{
  "name": "nrl22-training-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "seed-props": "node --env-file=.env.local scripts/seed-props.mjs",
    "backfill-cof-archive": "node --experimental-strip-types --env-file=.env.local scripts/backfill-cof-archive.mjs"
  },
  "overrides": {
    "browserslist": "^4.29.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@neondatabase/serverless": "^1.0.0",
    "@serwist/next": "^9.5.12",
    "next": "16.3.5",
    "pdf-to-img": "^7.0.0",
    "pdfjs-dist": "~6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
